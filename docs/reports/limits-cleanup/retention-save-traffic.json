{
  "status": "Before attempt-tagged uploads; measured offline, not projected improvements.",
  "methodology": {
    "initial_artifacts": 155,
    "calls_per_workload": 6,
    "fixtures": "Independent inline and detached workloads; distinct reports; cold Checkpoints/Store every call; no shared process cache.",
    "retention_save": "Only cp.save after setting completed operation.response; excludes cold load.",
    "whole_call_storage": "Cold load, response retention, simulated deterministic application, save, conversation publication, receipt save, dashboard write/readback. No model dispatch, CI, native PR reviews or unrelated stage/command GitHub traffic.",
    "identity": "Both workloads start from the same prepared fixture. Six distinct simulated reports add six artifacts. One logical call is charged per fixture iteration; zero harness invocations.",
    "GET": "Includes direct and paginated requests, including comments; collection_GET is artifact collections only.",
    "response_bytes": "CommonMark/JSON model, not GitHub measurement.",
    "warm_lifecycle_caveat": "The previous 48-report script retains the same Store across its 48 calls, then makes ten cold idle ticks; it is not a cold-per-call baseline."
  },
  "reproducer": "\"\"\"Offline cold-call retention measurements; no model or remote calls.\"\"\"\nimport json\nimport sys\nfrom copy import deepcopy\nfrom pathlib import Path\n\nroot=Path(sys.argv[1])\nsys.path.insert(0,str(root/'engine/tests'))\nimport support\nimport conversation\nfrom checkpoints import Checkpoints, MARKER\nfrom discovery_traffic import OperationTraffic, prepared, queue\nfrom fakes import CONFIG\n\n\ndef snapshot(gh):\n    return {k:gh.counts[k] for k in ('GET','collection_GET','POST','PATCH')}\n\n\ndef report(index,large):\n    return {'decision':'approve','rationale':f'Attempt {index}: '+('Verified source evidence. '*1000 if large else 'Verified.'),'concerns':[],'questions':[]}\n\n\ndef measure(large,count=6):\n    gh,state=prepared(OperationTraffic())\n    rows=[]\n    for i in range(count):\n        existing=len(gh.artifacts[7])\n        gh.counts.clear();gh.uploaded=gh.downloaded=0\n        cp=Checkpoints(gh,CONFIG,7)\n        state=cp.load(gh.comments)\n        loaded=snapshot(gh)\n        state['calls']+=1\n        value=report(i,large)\n        state['operation']={'status':'completed','response':deepcopy(value)}\n        before=snapshot(gh)\n        cp.save(state)\n        retained=snapshot(gh)\n        retention={k:retained[k]-before[k] for k in before}\n        if state.get('qc',{}).get('plan'):\n            state.setdefault('qc_history',[]).append(deepcopy(state['qc']['plan']))\n        state['qc']['plan']=deepcopy(value)\n        queue(state)\n        state.pop('operation')\n        cp.save(state)\n        conversation.publish(state,gh,CONFIG,cp.reports)\n        cp.save(state)\n        cp.publish_dashboard(MARKER+f'\\nCompleted calls: {state[\"calls\"]}\\n'+cp.links()[1]+'\\n')\n        rows.append({'call':i+1,'existing_artifacts':existing,'response_json_bytes':len(json.dumps(value).encode()),'cold_load':loaded,'retention_save':retention,'whole_call_storage':snapshot(gh),'new_artifacts':len(gh.artifacts[7])-existing,'uploaded_json_bytes':gh.uploaded,'modeled_response_bytes':gh.downloaded})\n    return {'response':'detached' if large else 'inline','calls':rows,'total':{k:sum(r['whole_call_storage'][k] for r in rows) for k in ('GET','collection_GET','POST','PATCH')},'harness_calls':0}\n\nprint(json.dumps({'workloads':[measure(False),measure(True)]},indent=2))\n",
