{
  "$defs": {
    "Dispatch": {
      "description": "New runner session that the operator must dispatch.",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Session to launch."
        }
      },
      "required": [
        "session_id"
      ],
      "type": "object"
    },
    "EventId": {
      "format": "uuid",
      "type": "string"
    },
    "EventKind": {
      "description": "The application rule for an event on the bus.",
      "oneOf": [
        {
          "const": "fact",
          "description": "An independently applicable occurrence.",
          "type": "string"
        },
        {
          "const": "snapshot",
          "description": "The complete state at one entity revision.",
          "type": "string"
        }
      ]
    },
    "ExchangeTurnStatus": {
      "description": "Operator lifecycle snapshot, appended with its state transaction.",
      "properties": {
        "created": {
          "$ref": "#/$defs/Timestamp",
          "description": "Admission time."
        },
        "dispatch": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dispatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "New session to dispatch."
        },
        "finished": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Terminal time."
        },
        "provider_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderFailure"
            },
            {
              "type": "null"
            }
          ],
          "description": "Trusted provider failure."
        },
        "refusal": {
          "description": "Latest refusal.",
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "description": "Bound GitHub Actions run.",
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current or last session."
        },
        "started": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Runner start time."
        },
        "status": {
          "description": "Queued, running, finished, lost or cancelled.",
          "type": "string"
        },
        "turn_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Turn whose state changed."
        }
      },
      "required": [
        "turn_id",
        "status",
        "created"
      ],
      "type": "object"
    },
    "ProviderFailure": {
      "description": "Trusted provider failure used for credential fallback.",
      "properties": {
        "category": {
          "description": "Failure category.",
          "type": "string"
        },
        "grant_id": {
          "description": "Funding grant.",
          "type": "string"
        },
        "model": {
          "description": "Model involved.",
          "type": "string"
        },
        "record_id": {
          "description": "Personal credential record, when applicable.",
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Request that reported the failure."
        },
        "retry_after": {
          "description": "Optional retry delay in seconds.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "version": {
          "description": "Personal credential version, when applicable.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "category",
        "model",
        "request_id",
        "grant_id"
      ],
      "type": "object"
    },
    "TaskId": {
      "format": "uuid",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/ExchangeTurnStatus",
      "description": "Contract payload."
    },
    "entity": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "snapshot"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "type": {
      "pattern": "^exchange\\.turn\\.[0-9a-f-]{36}\\.status$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
