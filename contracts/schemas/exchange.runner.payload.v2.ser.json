{
  "$defs": {
    "BlobRef": {
      "additionalProperties": false,
      "description": "A content-addressed runner artifact.",
      "properties": {
        "sha256": {
          "description": "Lowercase SHA-256 digest.",
          "type": "string"
        },
        "size": {
          "description": "Original byte count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Turn input delivered to the v2 runner.",
  "properties": {
    "feedback": {
      "description": "Prior-turn feedback."
    },
    "request": {
      "description": "Frozen model request."
    },
    "retained": {
      "anyOf": [
        {
          "$ref": "#/$defs/BlobRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Retained archive to restore, when continuing."
    },
    "spec": {
      "description": "Frozen checkout and workspace specification."
    },
    "timeout": {
      "description": "Optional execution limit in seconds; null uses the outer runner lifetime.",
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "request",
    "feedback",
    "spec",
    "timeout",
    "retained"
  ],
  "title": "TurnPayloadV2",
  "type": "object"
}
