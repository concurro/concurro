{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A content-addressed runner artifact.",
  "properties": {
    "sha256": {
      "description": "Lowercase SHA-256 digest.",
      "type": "string"
    },
    "size": {
      "description": "Original byte count.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "sha256",
    "size"
  ],
  "title": "BlobRef",
  "type": "object"
}
