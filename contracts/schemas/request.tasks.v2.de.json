{
  "$defs": {
    "EventId": {
      "format": "uuid",
      "type": "string"
    },
    "EventKind": {
      "description": "The application rule for an event on the bus.",
      "oneOf": [
        {
          "const": "fact",
          "description": "An independently applicable occurrence.",
          "type": "string"
        },
        {
          "const": "snapshot",
          "description": "The complete state at one entity revision.",
          "type": "string"
        }
      ]
    },
    "RequestActor": {
      "description": "Authenticated GitHub identity responsible for a request.",
      "properties": {
        "id": {
          "description": "GitHub numeric account ID.",
          "format": "int64",
          "type": "integer"
        },
        "login": {
          "description": "GitHub login at source capture time.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "login"
      ],
      "type": "object"
    },
    "RequestId": {
      "format": "uuid",
      "type": "string"
    },
    "RequestOutcome": {
      "description": "One durable request decision for publication and read models.",
      "oneOf": [
        {
          "description": "Start a task.",
          "properties": {
            "kind": {
              "const": "start",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Stop a task.",
          "properties": {
            "kind": {
              "const": "stop",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Remove label enrollment without stopping an existing task.",
          "properties": {
            "kind": {
              "const": "unenroll",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Approve one plan identity.",
          "properties": {
            "argument": {
              "properties": {
                "plan_id": {
                  "description": "Exact approved plan identity.",
                  "type": "string"
                }
              },
              "required": [
                "plan_id"
              ],
              "type": "object"
            },
            "kind": {
              "const": "approve",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "argument"
          ],
          "type": "object"
        },
        {
          "description": "Extend the plan-revision budget.",
          "properties": {
            "argument": {
              "properties": {
                "plan_revisions": {
                  "description": "Added plan revisions.",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "plan_revisions"
              ],
              "type": "object"
            },
            "kind": {
              "const": "extend",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "argument"
          ],
          "type": "object"
        },
        {
          "description": "Resume with an optional description-only scope.",
          "properties": {
            "argument": {
              "properties": {
                "description_only": {
                  "description": "Limit the resumed work to the PR description.",
                  "type": "boolean"
                }
              },
              "required": [
                "description_only"
              ],
              "type": "object"
            },
            "kind": {
              "const": "resume",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "argument"
          ],
          "type": "object"
        },
        {
          "description": "Offer sponsorship for one or any provider.",
          "properties": {
            "argument": {
              "properties": {
                "provider": {
                  "description": "Provider when the offer is scoped.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "type": "object"
            },
            "kind": {
              "const": "sponsor",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "argument"
          ],
          "type": "object"
        },
        {
          "description": "Withdraw consent for one provider.",
          "properties": {
            "argument": {
              "properties": {
                "provider": {
                  "description": "Provider losing consent.",
                  "type": "string"
                }
              },
              "required": [
                "provider"
              ],
              "type": "object"
            },
            "kind": {
              "const": "withdraw",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "argument"
          ],
          "type": "object"
        },
        {
          "description": "Select a funding provider and mode.",
          "properties": {
            "argument": {
              "properties": {
                "mode": {
                  "description": "Organization or personal mode.",
                  "type": "string"
                },
                "provider": {
                  "description": "Funding provider.",
                  "type": "string"
                }
              },
              "required": [
                "provider",
                "mode"
              ],
              "type": "object"
            },
            "kind": {
              "const": "funding",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "argument"
          ],
          "type": "object"
        },
        {
          "description": "Retry a permitted operation.",
          "properties": {
            "kind": {
              "const": "retry",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Invalidate the current task decision.",
          "properties": {
            "kind": {
              "const": "invalidate",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "actor": {
          "$ref": "#/$defs/RequestActor",
          "description": "Verified request actor."
        },
        "channel": {
          "description": "Channel that authenticated the source.",
          "type": "string"
        },
        "issue": {
          "$ref": "#/$defs/TaskIssue",
          "description": "GitHub issue addressed by the request."
        },
        "reason": {
          "description": "Refusal or supersession reason.",
          "type": [
            "string",
            "null"
          ]
        },
        "reply": {
          "description": "Channel route for an outcome reply.",
          "type": "string"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId",
          "description": "Stable request ID."
        },
        "source": {
          "description": "Stable channel source revision.",
          "type": "string"
        },
        "source_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the actor made this source revision."
        },
        "status": {
          "$ref": "#/$defs/RequestOutcomeStatus",
          "description": "Final status that also selects the event type."
        },
        "task_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Task, when one already exists or was created."
        }
      },
      "required": [
        "request_id",
        "issue",
        "actor",
        "channel",
        "source",
        "source_at",
        "status",
        "reply"
      ],
      "type": "object"
    },
    "RequestOutcomeStatus": {
      "description": "Final disposition of a request in the task decision queue.",
      "oneOf": [
        {
          "const": "applied",
          "description": "The request applied its allowed decision.",
          "type": "string"
        },
        {
          "const": "refused",
          "description": "The request could not be applied.",
          "type": "string"
        },
        {
          "const": "superseded",
          "description": "A newer source revision or applied control made the request obsolete.",
          "type": "string"
        }
      ]
    },
    "TaskId": {
      "format": "uuid",
      "type": "string"
    },
    "TaskIssue": {
      "description": "Stable issue identity used by task and request records.",
      "properties": {
        "number": {
          "description": "Repository-local issue number.",
          "format": "int64",
          "type": "integer"
        },
        "repository_id": {
          "description": "GitHub repository ID.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "repository_id",
        "number"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/RequestOutcome",
      "description": "Contract payload."
    },
    "entity": {
      "type": "null"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "fact"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "type": "null"
    },
    "type": {
      "pattern": "^request\\.tasks\\.(?:applied|refused|superseded)$",
      "type": "string"
    },
    "version": {
      "const": 2
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
