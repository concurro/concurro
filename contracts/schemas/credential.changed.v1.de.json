{
  "$defs": {
    "CredentialChange": {
      "description": "The kind of credential change.",
      "oneOf": [
        {
          "const": "added",
          "description": "An entry was added, or a relay approved.",
          "type": "string"
        },
        {
          "const": "replaced",
          "description": "An entry's secret or relay device was replaced.",
          "type": "string"
        },
        {
          "const": "edited",
          "description": "An entry's name, filters or enabled state changed.",
          "type": "string"
        },
        {
          "const": "reordered",
          "description": "A provider list was reordered.",
          "type": "string"
        },
        {
          "const": "removed",
          "description": "An entry was removed.",
          "type": "string"
        },
        {
          "const": "unusable",
          "description": "A version became unusable, as when it expired.",
          "type": "string"
        }
      ]
    },
    "CredentialChanged": {
      "additionalProperties": false,
      "description": "One committed change to an owner's credential entries or provider lists.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the change committed."
        },
        "change": {
          "$ref": "#/$defs/CredentialChange",
          "description": "What changed."
        },
        "entry_id": {
          "description": "The changed entry; absent for a reorder.",
          "type": [
            "string",
            "null"
          ]
        },
        "list_revision": {
          "description": "The provider list revision after the change.",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "provider": {
          "description": "`anthropic`, `google` or `openai`.",
          "type": "string"
        },
        "revoked": {
          "description": "Versions this change retired.",
          "items": {
            "$ref": "#/$defs/RevokedVersion"
          },
          "type": "array"
        },
        "sequence": {
          "description": "The accounts service's change sequence, increasing across all owners.",
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "user_id": {
          "description": "GitHub owner ID.",
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "user_id",
        "sequence",
        "provider",
        "change",
        "list_revision",
        "revoked",
        "at"
      ],
      "type": "object"
    },
    "EventId": {
      "format": "uuid",
      "type": "string"
    },
    "EventKind": {
      "description": "The application rule for an event on the bus.",
      "oneOf": [
        {
          "const": "fact",
          "description": "An independently applicable occurrence.",
          "type": "string"
        },
        {
          "const": "snapshot",
          "description": "The complete state at one entity revision.",
          "type": "string"
        }
      ]
    },
    "RevokedVersion": {
      "additionalProperties": false,
      "description": "One credential version a change retired.",
      "properties": {
        "custody": {
          "description": "`vault` (the accounts secret store) or `relay`.",
          "type": "string"
        },
        "record_id": {
          "description": "Opaque version identity, `sha256(\"{user}/{route}/{version}\")` in hex.",
          "type": "string"
        },
        "route": {
          "description": "Credential route.",
          "type": "string"
        },
        "version": {
          "description": "Version number.",
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "version",
        "route",
        "custody"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/CredentialChanged",
      "description": "Contract payload."
    },
    "entity": {
      "type": "null"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "fact"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "type": "null"
    },
    "type": {
      "pattern": "^credential\\.[1-9][0-9]*\\.changed$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
