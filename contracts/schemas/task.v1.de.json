{
  "$defs": {
    "EventId": {
      "format": "uuid",
      "type": "string"
    },
    "EventKind": {
      "description": "The application rule for an event on the bus.",
      "oneOf": [
        {
          "const": "fact",
          "description": "An independently applicable occurrence.",
          "type": "string"
        },
        {
          "const": "snapshot",
          "description": "The complete state at one entity revision.",
          "type": "string"
        }
      ]
    },
    "RequestActor": {
      "description": "Authenticated GitHub identity responsible for a request.",
      "properties": {
        "id": {
          "description": "GitHub numeric account ID.",
          "format": "int64",
          "type": "integer"
        },
        "login": {
          "description": "GitHub login at source capture time.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "login"
      ],
      "type": "object"
    },
    "TaskBudget": {
      "description": "One task budget counter and its configured limit.",
      "properties": {
        "max": {
          "description": "Frozen maximum for this task.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "used": {
          "description": "Charged use so far.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "used",
        "max"
      ],
      "type": "object"
    },
    "TaskBudgets": {
      "description": "Budget counters shown with a task state snapshot.",
      "properties": {
        "fix_rounds": {
          "$ref": "#/$defs/TaskBudget",
          "description": "Fix rounds, introduced in M2."
        },
        "model_calls": {
          "$ref": "#/$defs/TaskBudget",
          "description": "Charged model calls."
        },
        "plan_revisions": {
          "$ref": "#/$defs/TaskBudget",
          "description": "Plan revisions, introduced in M2."
        }
      },
      "required": [
        "model_calls",
        "fix_rounds",
        "plan_revisions"
      ],
      "type": "object"
    },
    "TaskId": {
      "format": "uuid",
      "type": "string"
    },
    "TaskIssue": {
      "description": "Stable issue identity used by task and request records.",
      "properties": {
        "number": {
          "description": "Repository-local issue number.",
          "format": "int64",
          "type": "integer"
        },
        "repository_id": {
          "description": "GitHub repository ID.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "repository_id",
        "number"
      ],
      "type": "object"
    },
    "TaskSnapshot": {
      "description": "Full M1 task state snapshot, revised after each durable state change.",
      "properties": {
        "attention": {
          "description": "Whether the current stage needs human attention.",
          "type": "boolean"
        },
        "author": {
          "$ref": "#/$defs/RequestActor",
          "description": "Author of the issue, distinct from any request actor."
        },
        "budgets": {
          "$ref": "#/$defs/TaskBudgets",
          "description": "Charged and configured task limits."
        },
        "enrollment": {
          "description": "Enrollment detail introduced in M3."
        },
        "initialized": {
          "description": "Whether pinned inputs have completed initialization.",
          "type": "boolean"
        },
        "issue": {
          "$ref": "#/$defs/TaskIssue",
          "description": "GitHub issue owning the task."
        },
        "kind": {
          "description": "Contribution in M1; later phases add standalone reviews.",
          "type": "string"
        },
        "mode": {
          "description": "Manual M1 task mode.",
          "type": "string"
        },
        "plan": {
          "description": "Plan detail introduced in M2."
        },
        "pull_request": {
          "description": "Pull request detail introduced in M2."
        },
        "stage": {
          "description": "Public stage after initialization.",
          "type": [
            "string",
            "null"
          ]
        },
        "stage_reason": {
          "description": "Stage's attention or release reason, when present.",
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Stable task identity."
        }
      },
      "required": [
        "task_id",
        "issue",
        "kind",
        "author",
        "initialized",
        "mode",
        "budgets",
        "attention"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/TaskSnapshot",
      "description": "Contract payload."
    },
    "entity": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "snapshot"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "type": {
      "pattern": "^task\\.[0-9a-f-]{36}\\.state$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
