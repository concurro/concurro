{
  "$defs": {
    "RunnerEngine": {
      "additionalProperties": false,
      "description": "Engine repository and immutable commit named by a runner claim.",
      "properties": {
        "repository": {
          "description": "Engine source repository.",
          "type": "string"
        },
        "sha": {
          "description": "Engine commit to execute.",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "sha"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Runner's first authenticated claim response.",
  "properties": {
    "deadline": {
      "$ref": "#/$defs/Timestamp",
      "description": "Session deadline."
    },
    "engine": {
      "$ref": "#/$defs/RunnerEngine",
      "description": "Engine source and pinned commit."
    },
    "runner_token": {
      "description": "Derived bearer for this session and run.",
      "type": "string"
    }
  },
  "required": [
    "engine",
    "runner_token",
    "deadline"
  ],
  "title": "RunnerClaimReply",
  "type": "object"
}
