{
  "$defs": {
    "EventId": {
      "format": "uuid",
      "type": "string"
    },
    "EventKind": {
      "description": "The application rule for an event on the bus.",
      "oneOf": [
        {
          "const": "fact",
          "description": "An independently applicable occurrence.",
          "type": "string"
        },
        {
          "const": "snapshot",
          "description": "The complete state at one entity revision.",
          "type": "string"
        }
      ]
    },
    "TaskId": {
      "format": "uuid",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    },
    "TurnRunner": {
      "description": "Runner identity currently associated with one turn observation.",
      "properties": {
        "run_attempt": {
          "description": "Actions rerun attempt, when observed.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "run_id": {
          "description": "GitHub Actions run, when observed.",
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Exchange runner session."
        }
      },
      "required": [
        "session_id"
      ],
      "type": "object"
    },
    "TurnStatus": {
      "description": "Latest observed lifecycle state of one turn.",
      "properties": {
        "created_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exchange admission time."
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Terminal time."
        },
        "runner": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnRunner"
            },
            {
              "type": "null"
            }
          ],
          "description": "Session and run associated with this observation."
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Runner start time."
        },
        "status": {
          "description": "Queued, running, finished or cancelled.",
          "type": "string"
        },
        "turn_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Turn whose state changed."
        }
      },
      "required": [
        "turn_id",
        "status"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/TurnStatus",
      "description": "Contract payload."
    },
    "entity": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "snapshot"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "type": {
      "pattern": "^turn\\.[0-9a-f-]{36}\\.status$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
