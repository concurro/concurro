{
  "$defs": {
    "BlobRef": {
      "additionalProperties": false,
      "description": "A content-addressed runner artifact.",
      "properties": {
        "sha256": {
          "description": "Lowercase SHA-256 digest.",
          "type": "string"
        },
        "size": {
          "description": "Original byte count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size"
      ],
      "type": "object"
    },
    "Dispatch": {
      "description": "New runner session that the operator must dispatch.",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Session to launch."
        }
      },
      "required": [
        "session_id"
      ],
      "type": "object"
    },
    "EventId": {
      "format": "uuid",
      "type": "string"
    },
    "EventKind": {
      "description": "The application rule for an event on the bus.",
      "oneOf": [
        {
          "const": "fact",
          "description": "An independently applicable occurrence.",
          "type": "string"
        },
        {
          "const": "snapshot",
          "description": "The complete state at one entity revision.",
          "type": "string"
        }
      ]
    },
    "ExchangeTurnFinished": {
      "description": "Terminal turn fact emitted once runner results are settled.",
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Task attempt identity."
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnObservation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Terminal operator snapshot retained with this fact beyond live-row pruning."
        },
        "provider_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderFailure"
            },
            {
              "type": "null"
            }
          ],
          "description": "Trusted provider failure."
        },
        "provider_requests": {
          "$ref": "#/$defs/ProviderRequests",
          "description": "Provider request evidence."
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnResultV2"
            },
            {
              "type": "null"
            }
          ],
          "description": "Runner result, if any."
        },
        "status": {
          "description": "Terminal status.",
          "type": "string"
        },
        "turn_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Exchange turn identity."
        },
        "usage": {
          "$ref": "#/$defs/TurnUsage",
          "description": "Request usage totals."
        }
      },
      "required": [
        "turn_id",
        "attempt_id",
        "status",
        "provider_requests",
        "usage"
      ],
      "type": "object"
    },
    "ProviderFailure": {
      "description": "Trusted provider failure used for credential fallback.",
      "properties": {
        "category": {
          "description": "Failure category.",
          "type": "string"
        },
        "grant_id": {
          "description": "Funding grant.",
          "type": "string"
        },
        "model": {
          "description": "Model involved.",
          "type": "string"
        },
        "record_id": {
          "description": "Personal credential record, when applicable.",
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Request that reported the failure."
        },
        "retry_after": {
          "description": "Optional retry delay in seconds.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "version": {
          "description": "Personal credential version, when applicable.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "category",
        "model",
        "request_id",
        "grant_id"
      ],
      "type": "object"
    },
    "ProviderRequests": {
      "description": "Provider request evidence, independent of the turn result.",
      "oneOf": [
        {
          "const": "some",
          "description": "At least one request reached the provider or verifier.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "All recorded requests finished before dispatch.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "No request was observed dispatched, and at least one report was lost.",
          "type": "string"
        }
      ]
    },
    "TaskId": {
      "format": "uuid",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    },
    "TurnObservation": {
      "description": "One durable turn observation returned by the operator API.",
      "properties": {
        "created": {
          "$ref": "#/$defs/Timestamp",
          "description": "Admission time."
        },
        "dispatch": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dispatch"
            },
            {
              "type": "null"
            }
          ],
          "description": "Session requiring an external dispatch."
        },
        "finished": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Terminal time."
        },
        "provider_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderFailure"
            },
            {
              "type": "null"
            }
          ],
          "description": "Trusted provider failure."
        },
        "provider_requests": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderRequests"
            },
            {
              "type": "null"
            }
          ],
          "description": "Recorded request evidence."
        },
        "refusal": {
          "description": "Latest runner refusal.",
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnResultV2"
            },
            {
              "type": "null"
            }
          ],
          "description": "Terminal runner result."
        },
        "revision": {
          "description": "Monotonic exchange lifecycle revision for readback fencing.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "run_id": {
          "description": "Bound GitHub Actions run.",
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current or last session."
        },
        "started": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "Runner start time."
        },
        "status": {
          "description": "Queued, running, finished, lost or cancelled.",
          "type": "string"
        },
        "turn_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Exchange turn identity."
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnUsage"
            },
            {
              "type": "null"
            }
          ],
          "description": "Settled request totals, available with terminal request evidence."
        }
      },
      "required": [
        "turn_id",
        "status",
        "created"
      ],
      "type": "object"
    },
    "TurnResultV2": {
      "additionalProperties": false,
      "description": "Runner result with blob references rather than embedded bytes.",
      "properties": {
        "elapsed_seconds": {
          "default": null,
          "description": "Elapsed execution time.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "outcome": {
          "description": "Engine outcome.",
          "type": "string"
        },
        "response": {
          "description": "Engine response content."
        },
        "retained": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Retained archive blob."
        },
        "termination_reason": {
          "default": null,
          "description": "Optional termination diagnostic.",
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Transcript archive blob."
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Workspace change JSON blob."
        }
      },
      "required": [
        "outcome",
        "response"
      ],
      "type": "object"
    },
    "TurnUsage": {
      "description": "Usage totals in one completed turn.",
      "properties": {
        "input_tokens": {
          "description": "Input tokens with known usage.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_tokens": {
          "description": "Output tokens with known usage.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "requests": {
          "description": "Recorded request count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unavailable": {
          "description": "Requests with unavailable usage.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "requests",
        "input_tokens",
        "output_tokens",
        "unavailable"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/ExchangeTurnFinished",
      "description": "Contract payload."
    },
    "entity": {
      "type": "null"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "fact"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "type": "null"
    },
    "type": {
      "pattern": "^exchange\\.turn\\.[0-9a-f-]{36}\\.finished$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
