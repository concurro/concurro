{
  "$defs": {
    "EventId": {
      "format": "uuid",
      "type": "string"
    },
    "EventKind": {
      "description": "The application rule for an event on the bus.",
      "oneOf": [
        {
          "const": "fact",
          "description": "An independently applicable occurrence.",
          "type": "string"
        },
        {
          "const": "snapshot",
          "description": "The complete state at one entity revision.",
          "type": "string"
        }
      ]
    },
    "TaskId": {
      "format": "uuid",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    },
    "TurnArtifact": {
      "description": "Content-addressed artifact kept by the task application.",
      "properties": {
        "bytes": {
          "description": "Original byte count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "media_type": {
          "description": "MIME type used when retrieving the artifact.",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 of the original artifact bytes.",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "bytes",
        "media_type"
      ],
      "type": "object"
    },
    "TurnFinished": {
      "description": "Immutable outcome of one turn, recorded with its result archive.",
      "properties": {
        "elapsed_seconds": {
          "description": "Exchange elapsed time.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "funding_ended": {
          "description": "Whether funding ended with this turn.",
          "type": "boolean"
        },
        "outcome": {
          "description": "Succeeded, failed or unknown.",
          "type": "string"
        },
        "provider_failure": {
          "description": "Structured provider failure, when supplied."
        },
        "provider_requests": {
          "description": "None, some or unknown paid provider requests.",
          "type": "string"
        },
        "reason": {
          "description": "Open diagnostic reason for the outcome.",
          "type": [
            "string",
            "null"
          ]
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnArtifact"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original model response artifact, when one was retained."
        },
        "transcript": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnTranscript"
            },
            {
              "type": "null"
            }
          ],
          "description": "Readable original transcript bundle."
        },
        "transcript_error": {
          "description": "Archive diagnostic if transcript decoding failed.",
          "type": [
            "string",
            "null"
          ]
        },
        "turn_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Turn that ended."
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnUsage"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exchange token and call totals when supplied by the Rust exchange."
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnArtifact"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original workspace change artifact, when supplied."
        }
      },
      "required": [
        "turn_id",
        "outcome",
        "provider_requests",
        "funding_ended"
      ],
      "type": "object"
    },
    "TurnTranscript": {
      "description": "A transcript bundle and its compressed size.",
      "properties": {
        "blob": {
          "description": "Original gzip content digest.",
          "type": "string"
        },
        "bytes": {
          "description": "Original compressed byte count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "blob",
        "bytes"
      ],
      "type": "object"
    },
    "TurnUsage": {
      "description": "Usage totals in one completed turn.",
      "properties": {
        "input_tokens": {
          "description": "Input tokens with known usage.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_tokens": {
          "description": "Output tokens with known usage.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "requests": {
          "description": "Recorded request count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unavailable": {
          "description": "Requests with unavailable usage.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "requests",
        "input_tokens",
        "output_tokens",
        "unavailable"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/TurnFinished",
      "description": "Contract payload."
    },
    "entity": {
      "type": "null"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "fact"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "type": "null"
    },
    "type": {
      "pattern": "^turn\\.[0-9a-f-]{36}\\.finished$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
