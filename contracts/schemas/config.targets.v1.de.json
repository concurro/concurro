{
  "$defs": {
    "ConfigLauncher": {
      "description": "Workflow file and exact ref used to launch runner sessions.",
      "properties": {
        "ref": {
          "description": "Ref selected by task settings.",
          "type": "string"
        },
        "workflow": {
          "description": "Executor workflow filename.",
          "type": "string"
        }
      },
      "required": [
        "workflow",
        "ref"
      ],
      "type": "object"
    },
    "ConfigTarget": {
      "description": "Task-owned target and launcher identity distributed to read-only consumers.",
      "properties": {
        "fork": {
          "description": "Runner fork owner and repository name.",
          "type": "string"
        },
        "issue_repository": {
          "description": "Issue source owner and repository name.",
          "type": "string"
        },
        "launcher": {
          "$ref": "#/$defs/ConfigLauncher",
          "description": "Configured executor launcher."
        },
        "repository_id": {
          "description": "Numeric issue repository identity.",
          "format": "int64",
          "type": "integer"
        },
        "reviewer_user_id": {
          "description": "Reviewer account for standalone PR requests, when configured.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "upstream": {
          "description": "Upstream owner and repository name.",
          "type": "string"
        },
        "upstream_repository_id": {
          "description": "Numeric upstream identity when distinct from the issue repository.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "repository_id",
        "upstream",
        "fork",
        "issue_repository",
        "launcher"
      ],
      "type": "object"
    },
    "ConfigTargets": {
      "description": "Complete target configuration at one task-service revision.",
      "properties": {
        "targets": {
          "description": "Configured target identities in settings order.",
          "items": {
            "$ref": "#/$defs/ConfigTarget"
          },
          "type": "array"
        }
      },
      "required": [
        "targets"
      ],
      "type": "object"
    },
    "EventId": {
      "format": "uuid",
      "type": "string"
    },
    "EventKind": {
      "description": "The application rule for an event on the bus.",
      "oneOf": [
        {
          "const": "fact",
          "description": "An independently applicable occurrence.",
          "type": "string"
        },
        {
          "const": "snapshot",
          "description": "The complete state at one entity revision.",
          "type": "string"
        }
      ]
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/ConfigTargets",
      "description": "Contract payload."
    },
    "entity": {
      "const": "config:targets"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "snapshot"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "type": {
      "const": "config.targets"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
