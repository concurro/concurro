{
  "$defs": {
    "Actor": {
      "description": "The actor responsible for a delivery.",
      "properties": {
        "id": {
          "description": "GitHub actor ID.",
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        "login": {
          "description": "GitHub login.",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ActorKind",
          "description": "Actor category, open to future GitHub values."
        }
      },
      "required": [
        "id",
        "login",
        "type"
      ],
      "type": "object"
    },
    "ActorKind": {
      "type": "string",
      "x-concurro-open": true
    },
    "EventId": {
      "format": "uuid",
      "type": "string"
    },
    "EventKind": {
      "description": "The application rule for an event on the bus.",
      "oneOf": [
        {
          "const": "fact",
          "description": "An independently applicable occurrence.",
          "type": "string"
        },
        {
          "const": "snapshot",
          "description": "The complete state at one entity revision.",
          "type": "string"
        }
      ]
    },
    "GithubEvent": {
      "description": "Fields shared by every mapped GitHub delivery.",
      "properties": {
        "action": {
          "description": "Open GitHub action name, absent for push and status.",
          "type": [
            "string",
            "null"
          ]
        },
        "delivery_id": {
          "description": "GitHub delivery GUID.",
          "type": "string"
        },
        "installation_id": {
          "description": "App installation ID.",
          "format": "int64",
          "type": "integer"
        },
        "mapping_revision": {
          "description": "Mapping code revision.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pull_request": {
          "$ref": "#/$defs/GithubPullRequest",
          "description": "PR snapshot."
        },
        "received_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Database receipt time."
        },
        "repository": {
          "$ref": "#/$defs/Repository",
          "description": "Repository identity."
        },
        "requested_reviewer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Requested individual, if any."
        },
        "requested_team": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestedTeam"
            },
            {
              "type": "null"
            }
          ],
          "description": "Requested team, if any."
        },
        "sender": {
          "$ref": "#/$defs/Actor",
          "description": "Actor responsible for the delivery."
        }
      },
      "required": [
        "delivery_id",
        "mapping_revision",
        "received_at",
        "installation_id",
        "repository",
        "sender",
        "action",
        "pull_request",
        "requested_reviewer",
        "requested_team"
      ],
      "type": "object"
    },
    "GithubPullRequest": {
      "description": "Pull request snapshot projected by the service.",
      "properties": {
        "additions": {
          "description": "Added line count.",
          "format": "int64",
          "type": "integer"
        },
        "base": {
          "$ref": "#/$defs/PullBase",
          "description": "Base identity."
        },
        "body": {
          "description": "Current body.",
          "type": [
            "string",
            "null"
          ]
        },
        "deletions": {
          "description": "Deleted line count.",
          "format": "int64",
          "type": "integer"
        },
        "draft": {
          "description": "Draft status.",
          "type": "boolean"
        },
        "head": {
          "$ref": "#/$defs/PullHead",
          "description": "Head identity."
        },
        "merge_commit_sha": {
          "description": "Merge commit if known.",
          "type": [
            "string",
            "null"
          ]
        },
        "merged": {
          "description": "Merge status.",
          "type": "boolean"
        },
        "node_id": {
          "description": "GraphQL node ID.",
          "type": "string"
        },
        "number": {
          "description": "Repository-local PR number.",
          "format": "int64",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/IssueState",
          "description": "Current state."
        },
        "title": {
          "description": "Current title.",
          "type": "string"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Latest update time."
        },
        "user": {
          "$ref": "#/$defs/Actor",
          "description": "PR author."
        }
      },
      "required": [
        "number",
        "node_id",
        "title",
        "body",
        "state",
        "draft",
        "merged",
        "merge_commit_sha",
        "user",
        "head",
        "base",
        "additions",
        "deletions",
        "updated_at"
      ],
      "type": "object"
    },
    "IssueState": {
      "description": "GitHub issue state, which is a closed wire enum.",
      "oneOf": [
        {
          "const": "open",
          "description": "Issue accepts new work.",
          "type": "string"
        },
        {
          "const": "closed",
          "description": "Issue is closed.",
          "type": "string"
        }
      ]
    },
    "PullBase": {
      "description": "Pull request base identity.",
      "properties": {
        "ref": {
          "description": "Branch name.",
          "type": "string"
        },
        "sha": {
          "description": "Base commit.",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha"
      ],
      "type": "object"
    },
    "PullHead": {
      "description": "Pull request head identity.",
      "properties": {
        "full_name": {
          "description": "Head repository full name, absent after a fork is deleted.",
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "description": "Branch name.",
          "type": "string"
        },
        "repository_id": {
          "description": "Head repository ID, absent after a fork is deleted.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "sha": {
          "description": "Head commit.",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha",
        "repository_id",
        "full_name"
      ],
      "type": "object"
    },
    "Repository": {
      "description": "GitHub repository identity used for routing.",
      "properties": {
        "full_name": {
          "description": "GitHub's owner and repository name.",
          "type": "string"
        },
        "id": {
          "description": "GitHub repository ID.",
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        "owner_id": {
          "description": "GitHub owner ID.",
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "owner_id",
        "full_name"
      ],
      "type": "object"
    },
    "RequestedTeam": {
      "description": "Team requested for review.",
      "properties": {
        "id": {
          "description": "Team ID.",
          "format": "int64",
          "type": "integer"
        },
        "slug": {
          "description": "Team slug.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/GithubEvent",
      "description": "Contract payload."
    },
    "entity": {
      "type": "null"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "fact"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "type": "null"
    },
    "type": {
      "pattern": "^github\\.pull_request(?:\\.[^.\\s*>\\u0000-\\u001f\\u007f-\\u009f]+)?$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
