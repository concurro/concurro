{
  "$defs": {
    "EventId": {
      "format": "uuid",
      "type": "string"
    },
    "EventKind": {
      "description": "The application rule for an event on the bus.",
      "oneOf": [
        {
          "const": "fact",
          "description": "An independently applicable occurrence.",
          "type": "string"
        },
        {
          "const": "snapshot",
          "description": "The complete state at one entity revision.",
          "type": "string"
        }
      ]
    },
    "ReadModelRecord": {
      "description": "Complete source record for the backoffice's event-fed read model.",
      "properties": {
        "body": {
          "description": "Complete source body at this revision."
        },
        "entity": {
          "description": "Baseline entity family.",
          "type": "string"
        },
        "entity_id": {
          "description": "Stable key within the family.",
          "type": "string"
        }
      },
      "required": [
        "entity",
        "entity_id",
        "body"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/ReadModelRecord",
      "description": "Contract payload."
    },
    "entity": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "snapshot"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "type": {
      "const": "view.record"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
