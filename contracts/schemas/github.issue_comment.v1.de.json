{
  "$defs": {
    "Actor": {
      "description": "The actor responsible for a delivery.",
      "properties": {
        "id": {
          "description": "GitHub actor ID.",
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        "login": {
          "description": "GitHub login.",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ActorKind",
          "description": "Actor category, open to future GitHub values."
        }
      },
      "required": [
        "id",
        "login",
        "type"
      ],
      "type": "object"
    },
    "ActorKind": {
      "type": "string",
      "x-concurro-open": true
    },
    "CommentIssue": {
      "description": "Issue fields consumed from a comment delivery.",
      "properties": {
        "created_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Creation time."
        },
        "is_pull_request": {
          "description": "Whether the issue is a pull request.",
          "type": "boolean"
        },
        "labels": {
          "description": "Current labels.",
          "items": {
            "$ref": "#/$defs/Label"
          },
          "type": "array"
        },
        "number": {
          "description": "Issue number.",
          "format": "int64",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/IssueState",
          "description": "Current issue state."
        },
        "title": {
          "description": "Issue title.",
          "type": "string"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Latest update time."
        },
        "user": {
          "$ref": "#/$defs/Actor",
          "description": "Issue author."
        }
      },
      "required": [
        "number",
        "title",
        "state",
        "is_pull_request",
        "user",
        "labels",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "EventId": {
      "format": "uuid",
      "type": "string"
    },
    "EventKind": {
      "description": "The application rule for an event on the bus.",
      "oneOf": [
        {
          "const": "fact",
          "description": "An independently applicable occurrence.",
          "type": "string"
        },
        {
          "const": "snapshot",
          "description": "The complete state at one entity revision.",
          "type": "string"
        }
      ]
    },
    "GithubComment": {
      "description": "Comment fields used by routing, observations and list projections.",
      "properties": {
        "author_association": {
          "description": "GitHub author association.",
          "type": "string"
        },
        "body": {
          "description": "Current body.",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Creation time."
        },
        "html_url": {
          "description": "Public comment URL.",
          "type": "string"
        },
        "id": {
          "description": "Comment ID.",
          "format": "int64",
          "type": "integer"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Latest update time."
        },
        "user": {
          "$ref": "#/$defs/Actor",
          "description": "Comment author."
        }
      },
      "required": [
        "id",
        "user",
        "author_association",
        "created_at",
        "updated_at",
        "html_url"
      ],
      "type": "object"
    },
    "GithubEvent": {
      "description": "Fields shared by every mapped GitHub delivery.",
      "properties": {
        "action": {
          "description": "Open GitHub action name, absent for push and status.",
          "type": [
            "string",
            "null"
          ]
        },
        "comment": {
          "$ref": "#/$defs/GithubComment",
          "description": "Comment snapshot."
        },
        "delivery_id": {
          "description": "GitHub delivery GUID.",
          "type": "string"
        },
        "installation_id": {
          "description": "App installation ID.",
          "format": "int64",
          "type": "integer"
        },
        "issue": {
          "$ref": "#/$defs/CommentIssue",
          "description": "Issue snapshot."
        },
        "mapping_revision": {
          "description": "Mapping code revision.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "previous_body": {
          "description": "Body before an edit, when supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "received_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Database receipt time."
        },
        "repository": {
          "$ref": "#/$defs/Repository",
          "description": "Repository identity."
        },
        "sender": {
          "$ref": "#/$defs/Actor",
          "description": "Actor responsible for the delivery."
        }
      },
      "required": [
        "delivery_id",
        "mapping_revision",
        "received_at",
        "installation_id",
        "repository",
        "sender",
        "issue",
        "comment"
      ],
      "type": "object"
    },
    "IssueState": {
      "description": "GitHub issue state, which is a closed wire enum.",
      "oneOf": [
        {
          "const": "open",
          "description": "Issue accepts new work.",
          "type": "string"
        },
        {
          "const": "closed",
          "description": "Issue is closed.",
          "type": "string"
        }
      ]
    },
    "Label": {
      "description": "A label attached to an issue.",
      "properties": {
        "name": {
          "description": "Label name as GitHub supplied it.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Repository": {
      "description": "GitHub repository identity used for routing.",
      "properties": {
        "full_name": {
          "description": "GitHub's owner and repository name.",
          "type": "string"
        },
        "id": {
          "description": "GitHub repository ID.",
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        "owner_id": {
          "description": "GitHub owner ID.",
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "owner_id",
        "full_name"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/GithubEvent",
      "description": "Contract payload."
    },
    "entity": {
      "type": "null"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "fact"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "type": "null"
    },
    "type": {
      "pattern": "^github\\.issue_comment(?:\\.[^.\\s*>\\u0000-\\u001f\\u007f-\\u009f]+)?$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
