{
  "$defs": {
    "EventId": {
      "format": "uuid",
      "type": "string"
    },
    "EventKind": {
      "description": "The application rule for an event on the bus.",
      "oneOf": [
        {
          "const": "fact",
          "description": "An independently applicable occurrence.",
          "type": "string"
        },
        {
          "const": "snapshot",
          "description": "The complete state at one entity revision.",
          "type": "string"
        }
      ]
    },
    "InferenceUsage": {
      "description": "One inference request's immutable accounting fact.",
      "properties": {
        "category": {
          "description": "Result category.",
          "type": "string"
        },
        "finished": {
          "$ref": "#/$defs/Timestamp",
          "description": "Settlement time."
        },
        "grant_id": {
          "description": "Funding grant.",
          "type": "string"
        },
        "model": {
          "description": "Provider model.",
          "type": "string"
        },
        "record_id": {
          "description": "Personal credential record, if used.",
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Gateway request identity."
        },
        "session_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Runner session."
        },
        "started": {
          "$ref": "#/$defs/Timestamp",
          "description": "Admission time."
        },
        "turn_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Running turn."
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageTokens"
            },
            {
              "type": "null"
            }
          ],
          "description": "Known token usage."
        },
        "usage_unavailable": {
          "description": "Reason usage could not be counted.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Personal credential version, if used.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "request_id",
        "session_id",
        "turn_id",
        "grant_id",
        "record_id",
        "version",
        "model",
        "category",
        "usage",
        "usage_unavailable",
        "started",
        "finished"
      ],
      "type": "object"
    },
    "TaskId": {
      "format": "uuid",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    },
    "UsageTokens": {
      "description": "Token accounting reported after one inference request.",
      "properties": {
        "cache_creation_input_tokens": {
          "default": null,
          "description": "Cache-created input tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cache_read_input_tokens": {
          "default": null,
          "description": "Cache-read input tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "input_tokens": {
          "description": "Provider input tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_tokens": {
          "description": "Provider output tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_input_tokens",
        "cache_creation_input_tokens"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/InferenceUsage",
      "description": "Contract payload."
    },
    "entity": {
      "type": "null"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "fact"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "type": "null"
    },
    "type": {
      "const": "inference.usage"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
