      "description": "One mapped GitHub issues delivery.",
      "type": "object",
      "x-concurro-open": true
    },
    "Issue": {
      "description": "Issue fields needed by routing and lists.",
      "properties": {
        "assignees": {
          "description": "Current assignees.",
          "items": {
            "$ref": "#/$defs/Actor"
          },
          "type": "array"
        },
        "body": {
          "description": "Current issue body, when present.",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Issue creation time."
        },
        "is_pull_request": {
          "description": "Whether this issue is a pull request.",
          "type": "boolean"
        },
        "labels": {
          "description": "Current labels.",
          "items": {
            "$ref": "#/$defs/Label"
          },
          "type": "array"
        },
        "number": {
          "description": "Repository-local issue number.",
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/IssueState",
          "description": "Current issue state."
        },
        "state_reason": {
          "description": "GitHub's state explanation, when present.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Current issue title.",
          "type": "string"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Latest issue update time."
        },
        "user": {
          "$ref": "#/$defs/Actor",
          "description": "Issue author."
        }
      },
      "required": [
        "number",
        "title",
        "body",
        "state",
        "state_reason",
        "user",
        "labels",
        "assignees",
        "created_at",
        "updated_at",
        "is_pull_request"
      ],
      "type": "object"
    },
    "IssueChanges": {
      "description": "Previous issue values supplied with an edit.",
      "properties": {
        "body_from": {
          "description": "Previous body, if changed.",
          "type": [
            "string",
            "null"
          ]
        },
        "title_from": {
          "description": "Previous title, if changed.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "title_from",
        "body_from"
      ],
      "type": "object"
    },
    "IssueState": {
      "description": "GitHub issue state, which is a closed wire enum.",
      "oneOf": [
        {
          "const": "open",
          "description": "Issue accepts new work.",
          "type": "string"
        },
        {
          "const": "closed",
          "description": "Issue is closed.",
          "type": "string"
        }
      ]
    },
    "Label": {
      "description": "A label attached to an issue.",
      "properties": {
        "name": {
          "description": "Label name as GitHub supplied it.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "NewIssue": {
      "description": "The destination key of a transferred issue.",
      "properties": {
        "number": {
          "description": "Destination issue number.",
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        "repository_id": {
          "description": "Destination repository ID.",
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        }
      },
      "required": [
        "repository_id",
        "number"
      ],
      "type": "object"
    },
    "Repository": {
      "description": "GitHub repository identity used for routing.",
      "properties": {
        "full_name": {
          "description": "GitHub's owner and repository name.",
          "type": "string"
        },
        "id": {
          "description": "GitHub repository ID.",
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        "owner_id": {
          "description": "GitHub owner ID.",
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "owner_id",
        "full_name"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/GithubIssues",
      "description": "Contract payload."
    },
    "entity": {
      "description": "Facts have no snapshot entity.",
      "type": "null"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "fact",
      "description": "Fact event."
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "description": "Facts have no snapshot revision.",
      "type": "null"
    },
    "type": {
      "description": "Concrete GitHub issue action type.",
      "pattern": "^github\\.issues\\.[^.\\s*>\\u0000-\\u001f\\u007f-\\u009f]+$(?![\\s\\S])",
      "type": "string"
    },
    "version": {
      "const": 1,
      "description": "Contract major version."
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
