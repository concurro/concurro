{
  "$defs": {
    "EventId": {
      "format": "uuid",
      "type": "string"
    },
    "EventKind": {
      "description": "The application rule for an event on the bus.",
      "oneOf": [
        {
          "const": "fact",
          "description": "An independently applicable occurrence.",
          "type": "string"
        },
        {
          "const": "snapshot",
          "description": "The complete state at one entity revision.",
          "type": "string"
        }
      ]
    },
    "TaskId": {
      "format": "uuid",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    },
    "TurnArtifact": {
      "description": "Content-addressed artifact kept by the task application.",
      "properties": {
        "bytes": {
          "description": "Original byte count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "media_type": {
          "description": "MIME type used when retrieving the artifact.",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 of the original artifact bytes.",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "bytes",
        "media_type"
      ],
      "type": "object"
    },
    "TurnSubmitted": {
      "description": "Funding and immutable inputs recorded when one paid attempt is admitted.",
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Task attempt identity, equal to the turn in M1."
        },
        "bundle_id": {
          "description": "Frozen instruction bundle identity.",
          "type": "string"
        },
        "effort": {
          "description": "Requested reasoning effort.",
          "type": [
            "string",
            "null"
          ]
        },
        "grant_id": {
          "description": "Funding grant identity, `org` for M1 organization funding.",
          "type": "string"
        },
        "harness": {
          "description": "Provider harness.",
          "type": "string"
        },
        "limits": {
          "description": "Budget and deadline limits supplied to the exchange."
        },
        "model": {
          "description": "Model selected for the paid attempt.",
          "type": "string"
        },
        "profile": {
          "description": "Optional agent profile.",
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnArtifact"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reconstructed prompt, if available."
        },
        "role": {
          "description": "Agent role at admission.",
          "type": "string"
        },
        "session": {
          "description": "Retained session identity when this is a continuation."
        },
        "spec": {
          "$ref": "#/$defs/TurnArtifact",
          "description": "Redacted immutable runner specification."
        },
        "stage": {
          "description": "Task stage at admission.",
          "type": "string"
        },
        "submitted_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Admission time."
        },
        "task_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Task charged for the attempt."
        },
        "turn_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Exchange turn identity."
        }
      },
      "required": [
        "turn_id",
        "attempt_id",
        "task_id",
        "grant_id",
        "stage",
        "role",
        "harness",
        "model",
        "effort",
        "profile",
        "session",
        "bundle_id",
        "limits",
        "spec",
        "prompt",
        "submitted_at"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/TurnSubmitted",
      "description": "Contract payload."
    },
    "entity": {
      "type": "null"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "fact"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "type": "null"
    },
    "type": {
      "pattern": "^turn\\.[0-9a-f-]{36}\\.submitted$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
