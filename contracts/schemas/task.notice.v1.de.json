{
  "$defs": {
    "EventId": {
      "format": "uuid",
      "type": "string"
    },
    "EventKind": {
      "description": "The application rule for an event on the bus.",
      "oneOf": [
        {
          "const": "fact",
          "description": "An independently applicable occurrence.",
          "type": "string"
        },
        {
          "const": "snapshot",
          "description": "The complete state at one entity revision.",
          "type": "string"
        }
      ]
    },
    "TaskId": {
      "format": "uuid",
      "type": "string"
    },
    "TaskNotice": {
      "description": "One task notice at a stable identity and revision.",
      "properties": {
        "data": {
          "description": "Category-specific notice fields."
        },
        "kind": {
          "description": "Notice category.",
          "type": "string"
        },
        "notice_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Stable notice identity."
        },
        "state": {
          "description": "Open, resolved or superseded.",
          "type": "string"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId",
          "description": "Task whose notice changed."
        }
      },
      "required": [
        "task_id",
        "notice_id",
        "kind",
        "state",
        "data"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A versioned event and its typed payload.",
  "properties": {
    "causation": {
      "description": "Source request or event, when known.",
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "$ref": "#/$defs/TaskNotice",
      "description": "Contract payload."
    },
    "entity": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/EventId",
      "description": "Stable event identifier across redeliveries and schema versions."
    },
    "kind": {
      "const": "snapshot"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Producer transaction time."
    },
    "producer": {
      "description": "Service that committed this event.",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "type": {
      "pattern": "^task\\.[0-9a-f-]{36}\\.notice$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "kind",
    "producer",
    "occurred_at",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
