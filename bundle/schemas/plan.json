{
  "type": "object",
  "properties": {
    "headline": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "When questions is empty, name 1\u20138 distinct primary editable files. Related follow-on edits belong in scope; files is not the exhaustive changed-file list."
    },
    "scope": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "When questions is empty, 1\u20138 distinct repository-relative paths, directories or globs, at most 200 characters each. Cover the design without bypassing target edit_policy."
        },
        "max_files": {
          "type": "integer",
          "description": "When questions is empty, an integer covering the number of primary files and all anticipated changed files, at most 32."
        }
      },
      "required": [
        "paths",
        "max_files"
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "response": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "response"
        ],
        "additionalProperties": false
      }
    },
    "publication": {
      "type": "object",
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 1,
          "maxItems": 5,
          "description": "1\u20135 short publication bullets, each 1\u2013300 characters. Put the full design and evidence in summary, steps and tests."
        },
        "review_focus": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 1,
          "maxItems": 5,
          "description": "1\u20135 short publication bullets, each 1\u2013300 characters. Put the full design and evidence in summary, steps and tests."
        }
      },
      "required": [
        "changes",
        "review_focus"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "headline",
    "summary",
    "questions",
    "files",
    "scope",
    "steps",
    "tests",
    "responses",
    "publication"
  ],
  "additionalProperties": false
}
