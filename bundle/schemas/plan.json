{
  "type": "object",
  "properties": {
    "headline": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Name distinct primary editable files. Related follow-on edits belong in scope; files is not the exhaustive changed-file list. Obey configured limits supplied in plan_output_contract."
    },
    "scope": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Distinct repository-relative paths, directories or globs covering the design. Obey the supplied limits.scope_paths and limits.scope_path_characters when non-null."
        }
      },
      "required": [
        "paths"
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "response": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "response"
        ],
        "additionalProperties": false
      }
    },
    "publication": {
      "type": "object",
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "description": "Concise publication bullets. Put the full design and evidence in summary, steps and tests."
        },
        "review_focus": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "description": "Concise publication bullets. Put the full design and evidence in summary, steps and tests."
        }
      },
      "required": [
        "changes",
        "review_focus"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "headline",
    "summary",
    "questions",
    "files",
    "scope",
    "steps",
    "tests",
    "responses",
    "publication"
  ],
  "additionalProperties": false
}
