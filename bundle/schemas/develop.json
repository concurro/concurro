{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "design_issue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "requirements",
                "plan"
              ]
            },
            "explanation": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "explanation",
            "evidence"
          ],
          "additionalProperties": false
        }
      ]
    },
    "validation": {
      "type": "string",
      "description": "Agent-reported commands, outcomes and any tests not run. Include relevant evidence without a fixed prose allowance."
    },
    "description": {
      "type": "object",
      "properties": {
        "lead": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\r\\n\\u0000]+$"
        },
        "problem": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?=.*\\S)[^\\r\\n\\u0000]+$"
          }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?=.*\\S)[^\\r\\n\\u0000]+$"
          }
        },
        "compatibility": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?=.*\\S)[^\\r\\n\\u0000]+$"
          }
        },
        "review_focus": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?=.*\\S)[^\\r\\n\\u0000]+$"
          }
        }
      },
      "required": [
        "lead",
        "problem",
        "changes",
        "compatibility",
        "review_focus"
      ],
      "additionalProperties": false
    },
    "commit": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\r\\n\\u0000]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "feat",
            "fix",
            "docs",
            "refactor",
            "perf",
            "test",
            "build",
            "ci",
            "chore",
            "revert"
          ]
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?=.*\\S)[^\\r\\n\\u0000]+$"
          }
        }
      },
      "required": [
        "subject",
        "type",
        "changes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "summary",
    "validation",
    "design_issue",
    "description",
    "commit"
  ],
  "additionalProperties": false
}
