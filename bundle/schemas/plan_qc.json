{
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "revise",
        "clarify",
        "reject",
        "escalate"
      ]
    },
    "headline": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Set high and escalate for consequential uncertainty requiring human judgment. This QC risk is distinct from advisory classification.change_risk."
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    },
    "concerns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 12
    },
    "scope": {
      "type": "object",
      "properties": {
        "goal_ids": {
          "type": "array",
          "description": "Copy each ID verbatim from the supplied charter goals: G-CORRECTNESS, not G-CORRECTNESS: improves validation. Put fit evidence in scope.fit; never invent IDs or use goal descriptions as IDs.",
          "items": {
            "type": "string"
          },
          "maxItems": 12
        },
        "fit": {
          "type": "string",
          "description": "Explain concrete fit with the cited charter goals; identify compatibility uncertainty."
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8
        }
      },
      "required": [
        "goal_ids",
        "fit",
        "conflicts"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "description": "A unique source ID used verbatim by assessments[].sources, for example S1."
          },
          "path": {
            "type": "string",
            "maxLength": 4096,
            "description": "A repository-relative file path in the pinned checkout, not a URL or path:line string."
          },
          "line": {
            "type": "integer",
            "description": "The 1-based line on which the literal quote starts."
          },
          "quote": {
            "type": "string",
            "description": "Literal text from the pinned file, not a paraphrase, command output or web page."
          }
        },
        "required": [
          "id",
          "path",
          "line",
          "quote"
        ],
        "additionalProperties": false
      },
      "maxItems": 12
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "maxLength": 16
          },
          "status": {
            "type": "string",
            "enum": [
              "satisfied",
              "defect",
              "uncertain"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 600
            },
            "maxItems": 12,
            "description": "Non-empty list of exact IDs declared in sources[].id, for example [\"S1\"]. Never put paths, path:line strings, URLs or explanations here."
          },
          "reason": {
            "type": "string"
          },
          "counterexample": {
            "type": "string"
          }
        },
        "required": [
          "criterion",
          "status",
          "sources",
          "reason",
          "counterexample"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "objection_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved"
            ]
          },
          "detail": {
            "type": "string"
          },
          "counterexample": {
            "type": "string"
          },
          "closure": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "detail",
          "counterexample",
          "closure",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 24
    }
  },
  "required": [
    "decision",
    "headline",
    "rationale",
    "risk",
    "questions",
    "concerns",
    "scope",
    "sources",
    "assessments",
    "objection_updates"
  ],
  "additionalProperties": false
}
