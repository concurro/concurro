{
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "revise",
        "clarify",
        "reject",
        "escalate"
      ]
    },
    "headline": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    },
    "concerns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 12
    },
    "scope": {
      "type": "object",
      "properties": {
        "goal_ids": {
          "type": "array",
          "description": "Exact keys from the supplied charter's goals, without explanations or suffixes. Put the explanation in scope.fit.",
          "items": {
            "type": "string"
          },
          "maxItems": 12
        },
        "fit": {
          "type": "string",
          "description": "Explain how the plan fits the cited charter goals."
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8
        }
      },
      "required": [
        "goal_ids",
        "fit",
        "conflicts"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "line": {
            "type": "integer"
          },
          "quote": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "line",
          "quote"
        ],
        "additionalProperties": false
      },
      "maxItems": 12
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "maxLength": 16
          },
          "status": {
            "type": "string",
            "enum": [
              "satisfied",
              "defect",
              "uncertain"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 600
            },
            "maxItems": 12
          },
          "reason": {
            "type": "string"
          },
          "counterexample": {
            "type": "string"
          }
        },
        "required": [
          "criterion",
          "status",
          "sources",
          "reason",
          "counterexample"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "objection_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved"
            ]
          },
          "detail": {
            "type": "string"
          },
          "counterexample": {
            "type": "string"
          },
          "closure": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "detail",
          "counterexample",
          "closure",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 24
    }
  },
  "required": [
    "decision",
    "headline",
    "rationale",
    "risk",
    "questions",
    "concerns",
    "scope",
    "sources",
    "assessments",
    "objection_updates"
  ],
  "additionalProperties": false
}
