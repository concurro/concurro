# The host's shared HTTPS entry point: one Caddy on 443 with the host's Let's Encrypt IP
# certificate. Each service contributes a route file in the sites directory; anything
# no route claims gets 404. Port 80 stays free for certbot.
{
	auto_https off
}

:443 {
	tls /tls/fullchain.pem /tls/privkey.pem

	import /etc/caddy/sites/*.caddy

	handle {
		respond 404
	}
}
