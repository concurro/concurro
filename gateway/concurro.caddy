# Concurro's routes on the shared edge (installed as /etc/edge/sites/concurro.caddy).
# Everything under /concurro/ arrives with the prefix removed: /concurro/v1/* is inference and
# /concurro/exchange/* the key exchange (the gateway), /concurro/webhook GitHub App deliveries
# (the service, which verifies their signatures).
handle /concurro/* {
	uri strip_prefix /concurro

	handle /webhook {
		reverse_proxy concurro-service:8787
	}

	handle /exchange/* {
		reverse_proxy concurro-gateway:8080
	}

	handle /v1/* {
		reverse_proxy concurro-gateway:4000 {
			# Stream server-sent events as they arrive.
			flush_interval -1
		}
	}

	handle {
		respond 404
	}
}
